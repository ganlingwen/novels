{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Novel editorial training bundle",
  "description": "One format for data/real/*.json and data/synthesized/*.json. Real author decisions remain archival facts; synthetic records require explicit provenance. Metadata is never used as an implicit training prompt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "records"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "nullableText": {"type": ["string", "null"]},
    "metadata": {
      "type": "object",
      "description": "Source, review, quality, tags, history, selection reasons and other annotations. Historical schema versions/counts here are provenance, not the current training contract."
    },
    "syntheticProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_record_ids", "source_group_id", "synthesis_method", "fact_sources",
        "generator", "judge", "audit_status"
      ],
      "properties": {
        "parent_record_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/text"},
          "uniqueItems": true
        },
        "source_group_id": {"$ref": "#/$defs/text"},
        "synthesis_method": {
          "enum": ["new_edit", "preference_transfer", "failure_injection", "no_change"]
        },
        "fact_sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/text"},
          "uniqueItems": true
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "prompt_template_version", "sampling"],
          "properties": {
            "model": {"$ref": "#/$defs/text"},
            "prompt_template_version": {"$ref": "#/$defs/text"},
            "sampling": {"type": "object"}
          }
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "rubric_version", "decision"],
          "properties": {
            "model": {"$ref": "#/$defs/text"},
            "rubric_version": {"$ref": "#/$defs/text"},
            "decision": {"enum": ["accepted", "rejected", "tie"]}
          }
        },
        "audit_status": {"enum": ["unreviewed", "machine_reviewed", "human_reviewed"]}
      }
    },
    "recordMetadata": {
      "type": "object",
      "properties": {
        "data_origin": {"enum": ["real", "synthetic"]},
        "synthetic_provenance": {"$ref": "#/$defs/syntheticProvenance"}
      },
      "if": {
        "required": ["data_origin"],
        "properties": {"data_origin": {"const": "synthetic"}}
      },
      "then": {"required": ["synthetic_provenance"]}
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_request", "context", "original_text", "metadata"],
      "properties": {
        "user_request": {"$ref": "#/$defs/text"},
        "context": {"$ref": "#/$defs/nullableText"},
        "original_text": {"$ref": "#/$defs/nullableText"},
        "metadata": {"$ref": "#/$defs/metadata"}
      }
    },
    "sft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "response", "metadata"],
      "properties": {
        "eligible": {"type": "boolean"},
        "response": {"$ref": "#/$defs/nullableText"},
        "metadata": {"$ref": "#/$defs/metadata"}
      },
      "if": {"properties": {"eligible": {"const": true}}},
      "then": {"properties": {"response": {"$ref": "#/$defs/text"}}}
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "response", "status", "pair_id", "metadata"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/text"},
        "response": {"$ref": "#/$defs/text"},
        "status": {
          "enum": [
            "chosen", "rejected", "chosen_then_refined", "chosen_direction",
            "partially_chosen", "rejected_as_full_candidate", "chosen_component", "pending"
          ],
          "description": "Historical author decision. Only exact rejected status exports a DPO pair; the chosen candidate is identified explicitly."
        },
        "pair_id": {
          "anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}],
          "description": "Stable, corpus-unique training ID for a rejected alternative in an eligible DPO record. Null for all other candidates."
        },
        "metadata": {"$ref": "#/$defs/metadata"}
      }
    },
    "dpo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "chosen_candidate_id", "candidates", "metadata"],
      "properties": {
        "eligible": {"type": "boolean"},
        "chosen_candidate_id": {
          "anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]
        },
        "candidates": {
          "type": "array",
          "items": {"$ref": "#/$defs/candidate"}
        },
        "metadata": {"$ref": "#/$defs/metadata"}
      },
      "if": {"properties": {"eligible": {"const": true}}},
      "then": {
        "properties": {
          "chosen_candidate_id": {"$ref": "#/$defs/text"},
          "candidates": {
            "minItems": 2,
            "contains": {
              "properties": {
                "status": {"const": "rejected"},
                "pair_id": {"$ref": "#/$defs/text"}
              }
            }
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "sft", "dpo", "metadata"],
      "properties": {
        "id": {
          "$ref": "#/$defs/text",
          "description": "Corpus-unique editorial record ID; also the SFT training ID when eligible."
        },
        "prompt": {"$ref": "#/$defs/prompt"},
        "sft": {"$ref": "#/$defs/sft"},
        "dpo": {"$ref": "#/$defs/dpo"},
        "metadata": {"$ref": "#/$defs/recordMetadata"}
      },
      "if": {
        "properties": {
          "metadata": {
            "required": ["data_origin"],
            "properties": {"data_origin": {"const": "synthetic"}}
          }
        },
        "anyOf": [
          {"properties": {"sft": {"properties": {"eligible": {"const": true}}}}},
          {"properties": {"dpo": {"properties": {"eligible": {"const": true}}}}}
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "synthetic_provenance": {
                "properties": {
                  "judge": {"properties": {"decision": {"const": "accepted"}}}
                }
              }
            }
          }
        }
      },
      "$comment": "LocalNovelDataset additionally validates unique record/candidate/pair IDs, chosen-ID references, pair-ID eligibility, and distinct chosen/rejected text."
    }
  }
}
